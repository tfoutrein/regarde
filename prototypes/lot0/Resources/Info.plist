    <true/>

    <!-- Le micro n'est pas utilise au lot 0, mais la cle est presente pour que le
         preflight T0.3 puisse interroger le statut sans faire planter le processus. -->
    <key>NSMicrophoneUsageDescription</key>
    <string>Regarde transcrit vos commentaires localement, sans jamais les envoyer sur le reseau.</string>
</dict>

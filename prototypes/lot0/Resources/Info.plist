<plist version="1.0">
<dict>
    <key>CFBundleName</key>
    <string>Regarde0</string>
    <key>CFBundleDisplayName</key>
    <string>Regarde (lot 0)</string>
    <key>CFBundleIdentifier</key>
    <string>dev.tfoutrein.regarde.lot0</string>
    <key>CFBundleExecutable</key>
    <string>Regarde0</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleShortVersionString</key>
    <string>0.0.1</string>
    <key>CFBundleVersion</key>
    <string>1</string>
    <key>LSMinimumSystemVersion</key>
    <string>26.0</string>

    <!-- T0.2 : aucune icone dans le Dock, ignore par Stage Manager, structurellement
         incapable de voler le focus a l'application testee. Voir ADR-0010. -->
